{
  "name": "cts",
  "version": "2.9.1",
  "description": "cts - circu.js bootstrap to provide full typescript experience",
  "main": "src/main.ts",
  "type": "module",
  "scripts": {
    "type-check": "tsc --noEmit",
    "build": "esbuild src/main.ts --bundle --platform=node --target=es2024 --format=esm --outfile=dist.js",
    "min-build": "esbuild src/main.ts --bundle --platform=node --target=es2024 --format=esm --minify --outfile=dist.min.js",
    "bundle": "cjsc -b cjs -s -e dist.js",
    "install-node": "cts utils/compile.ts --all",
    "install-node-cjs": "esbuild utils/compile.ts --bundle --target=es2024 --format=esm --outfile=compile.js && cjs compile.js --all",
    "install-node:clean": "cts utils/compile.ts --all --clean",
    "install-node-cjs:clean": "esbuild utils/compile.ts --bundle --target=es2024 --format=esm --outfile=compile.js && cjs compile.js --all --clean"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.17.1",
  "dependencies": {
    "@cnojs/http": "workspace:../http",
    "@formatjs/intl": "^4.0.6",
    "@formatjs/intl-datetimeformat": "^7.0.6",
    "@formatjs/intl-displaynames": "^7.0.6",
    "@formatjs/intl-numberformat": "^9.0.7",
    "@formatjs/intl-relativetimeformat": "^12.0.7",
    "buffer": "^6.0.3",
    "headers-polyfill": "^4.0.3",
    "sucrase": "^3.35.1",
    "temporal-polyfill": "^0.3.0",
    "urlpattern-polyfill": "^10.1.0",
    "whatwg-url": "^15.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "esbuild": "^0.27.0"
  }
}
